# ---- Database ----
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant
POSTGRES_DB=restaurant

# ---- Gateway ----
HTTP_PORT=8080

# ---- API ----
# Change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of the app (used for Stripe redirects and QR codes)
APP_URL=http://localhost:8080
CURRENCY=aud
TAX_RATE=0.10
TAX_INCLUSIVE=true
RESTAURANT_NAME=Ember & Oak
RESTAURANT_TZ=Australia/Melbourne
# Load sample menu, tables, staff and customers on first start (true/false)
SEED_DEMO_DATA=true
# First manager account (created only when there are no staff yet)
ADMIN_EMAIL=manager@demo.com
ADMIN_PASSWORD=password123

# Feature modules. Remove a name to switch that module off for this restaurant.
# Available: tables,menu,specials,orders,payments,loyalty,reservations,stats,kitchen
ENABLED_MODULES=tables,menu,specials,orders,payments,loyalty,reservations,stats,kitchen

# ---- Payments (Stripe) ----
# Leave blank to use the built-in simulated provider (good for demos).
# Use test keys (sk_test_..., pk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Web ----
NEXT_PUBLIC_RESTAURANT_NAME=Ember & Oak
